# ─────────────────────────────────────────────────────────────
#  Interview Quasar — Backend Environment Variables
#  Copy this file to .env and fill in your values
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=8081
APP_URL="http://localhost:8081"
CORS_ORIGIN="http://localhost:5173"

# ── Database ──────────────────────────────────────────────────
MONGODB_URI="mongodb://127.0.0.1:27017/quasar"

# ── Authentication ────────────────────────────────────────────
# Generate strong random strings for production!
JWT_ACCESS_SECRET="replace-with-a-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-another-strong-random-secret"

# ── AI Services ───────────────────────────────────────────────
# Gemini API Key — powers live voice interviews (Gemini 3.1 Flash Live API)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Groq API Key — powers JD parsing, transcript evaluation, coach chat, report generation
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=""

# NeevCloud API Key — alternative LLM provider (used for resume screening & MCQ generation)
# Get yours at: https://neevcloud.com
NEEV_API_KEY=""

# ── OAuth (optional — enable social login) ────────────────────
# Google OAuth 2.0
# Set up at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
# Set up at: https://github.com/settings/applications/new
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Email (SMTP) ──────────────────────────────────────────────
# Required for: agent escalation alerts, daily digests, candidate invitations
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@example.com"

# ── Object Storage (MinIO / S3-compatible) ────────────────────
# Used for: resume PDF uploads
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=quasar
MINIO_USE_SSL=false
